# git ignore

# Ignore ISO files
*.iso
tftpboot/iso-extracted/*
!tftpboot/iso/.gitkeep
!tftpboot/iso-extracted/.gitkeep

# Ignore images
*.img
*.ova
*.qcow2
tftpboot/disk-images/
!tftpboot/disk-images/.gitkeep

# Ignore archives
*.tar.gz
*.zip
*.tgz

# Ignore darksite storage
tftpboot/nce-darksite/lcm-bundles/*.tar.gz
tftpboot/nce-darksite/release/*
!tftpboot/nce-darksite/release/.gitkeep

# NixOS netboot (rebuildable via nix-build)
tftpboot/images/nixos/
result-*
*.drv

# iVentoy
tftpboot/tools/iventoy/log/log.txt
tftpboot/tools/iventoy/iso/

# Memtest86 (download separately)
tftpboot/tools/memtest86/memtest86-usb.img

# dotenv
.env

# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

