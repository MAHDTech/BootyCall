#!ipxe

#########################
# Global Variables
#########################

set server_proto http
set server_name bootycall.saltlabs.cloud
set server_ip 10.10.1.1

#########################
# Colour Palette
#########################

# 0=Black, 1=Blue, 2=Green, 3=Cyan, 4=Red, 5=Magenta, 6=Yellow, 7=White

# Color Pair 0: The Screen Background
#   Foreground: Transparent
#   Background: Transparent
cpair 0

# Color Pair 1: Normal Text
#   Foreground: Cyan (3)
#   Background: Transparent
cpair --foreground 3 1

# Color Pair 2: Selection
#   Foreground: Black (0)
#   Background: Magenta (5)
cpair --foreground 0 --background 5 2

# Color Pair 3: Headers
#   Foreground: Yellow (6)
#   Background: Transparent
cpair --foreground 6 3

#########################
:start
#########################

set hd_video true           # Default to HD Video.

# Check for VM manufacturers.
iseq ${manufacturer} QEMU && echo "Running in QEMU, lowering resolution" && set hd_video false ||
iseq ${manufacturer} KVM && echo "Running in KVM, lowering resolution" && set hd_video false ||
iseq ${manufacturer} VirtualBox && echo "Running in VirtualBox, lowering resolution" && set hd_video false ||
iseq ${manufacturer} VMware && echo "Running in VMware, lowering resolution" && set hd_video false ||

# Set the wallpaper
chain ${server_proto}://${server_name}/dynamic/wallpaper.ipxe?hd_video=${hd_video}

#########################
:menu
#########################

menu BootyCall System Interface

item --gap -- ----------------------------------------------------
item --gap --             BOOTYCALL MAIN TERMINAL
item --gap -- ----------------------------------------------------
item --gap --
item --gap --   :: OPERATING ENVIRONMENTS ::
item --gap --
item netboot        > Netboot (Default)
item iventoy        > iVentoy
item threefold      > Threefold ZeroOS
item nce_iso        > Nutanix CE (ISO)
item nce_hdd        > Nutanix CE (HDD)
item --gap --
item --gap --   :: DIAGNOSTICS & TOOLS ::
item --gap --
item mt86plus     > Memtest86+
item mt86passmark > MemTest86 PassMark
item shell        > iPXE Shell
item --gap --
item --gap --   :: POWER CONTROL ::
item --gap --
item reboot       [ SYSTEM REBOOT ]
item exit         [ EXIT TO BIOS  ]
item --gap --
item --gap -- ----------------------------------------------------

# Choose with a timeout of 60 seconds
choose --default netboot --timeout 60000 selected || goto cancel

goto ${selected}

#########################
:hotkeys
#########################

item --key n netboot        [N] Netboot.xyz
item --key m mt86plus       [M] Memtest86+
item --key p mt86passmark   [P] PassMark MemTest86
item --key t threefold      [T] Threefold Cloud
item --key u nce            [U] Nutanix Community Edition
item --key s shell          [S] iPXE shell
item --key r reboot         [R] Reboot computer
item --key x exit           [X] Exit to BIOS/UEFI

#########################
:netboot
#########################

echo Loading Netboot menu ...

chain --autofree ${server_proto}://${server_name}/ipxe/netboot.ipxe || goto failed

goto start

#########################
:iventoy
#########################

echo Loading iVentoy ...

set iventoy-proto tftp
set iventoy-server 0.0.0.0
set iventoy-port 16000

# iVentoy in Internal or External mode (snooping)
#chain ${iventoy-proto}://${iventoy-server}/iventoy_loader_16000 || goto failed

# iVentoy in ExternalNet mode.
iseq ${platform} efi && chain --autofree ${iventoy-proto}://${iventoy-server}/iventoy_loader_16000_uefi ||
iseq ${platform} pcbios && chain --autofree ${iventoy-proto}://${iventoy-server}/iventoy_loader_16000_bios ||
echo "No iVentoy loader available for this platform ${platform}." && goto failed

goto start

#########################
:mt86plus
#########################

echo Loading Memtest86+ ...

chain ${server_proto}://${server_name}/tools/mt86plus/memtest86plus.efi || goto failed

goto start

#########################
:mt86passmark
#########################

echo Loading PassMark MemTest86 ...

# NOTE: Only site version works with chain.
#chain ${server_proto}://${server_name}/tools/memtest86/memtest86.efi || goto failed

# NOTE: Free version seems to work with sanboot.
sanboot ${server_proto}://${server_name}/tools/memtest86/memtest86-usb.img || goto failed

goto start

#########################
:threefold
#########################

echo Loading Threefold ZeroOS ...

chain --autofree ${server_proto}://${server_name}/ipxe/threefold.ipxe || goto failed

goto start

#########################
:nce_iso
#########################

# NOTE: This uses a custom ISO with modified initrd and squashfs to work with iPXE.

echo Loading Nutanix Community Edition (DVD) ...

# The location of the ISO file.
set phoenix_iso ${server_proto}://${server_name}/iso/phoenix.x86_64-fnd_5.6.1_patch-aos_6.8.1_ga_ipxe.iso

# Sanboot using EL Torito emulation.
sanboot --drive 0xe0 --no-describe ${phoenix_iso} || goto failed

goto start

#########################
:nce_hdd
#########################

# NOTE: This uses a custom ISO with modified initrd and squashfs to work with iPXE.

echo Loading Nutanix Community Edition (HDD) ...

# The location of the ISO file.
set phoenix_iso ${server_proto}://${server_name}/iso/phoenix.x86_64-fnd_5.6.1_patch-aos_6.8.1_ga_ipxe.iso

# Sanboot using block device
sanboot --drive 0x80 ${phoenix_iso} --no-describe || goto failed

goto start

#########################
:failed
#########################

echo Boot failed - returning to menu in 10 seconds ...

sleep 10
goto start

#########################
:cancel
#########################

echo Boot cancelled.

sleep 3
exit

#########################
:shell
#########################

echo Loading iPXE shell

shell
goto start

#########################
:reboot
#########################

echo Rebooting...

sleep 3
reboot

#########################
:exit
#########################

echo Exiting ...

exit
